# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# Docker Compose sets these inline in docker-compose.yml — this file is for
# running the worker directly on your host (e.g. pnpm dev).

# RabbitMQ connection URL
# Host machine:   amqp://admin:secret@localhost:5672
# Docker network: amqp://admin:secret@rabbitmq:5672
RABBITMQ_URL=amqp://admin:secret@localhost:5672

# Must match API/worker topology (defaults are fine for local dev)
RABBITMQ_QUEUE=votes.queue
RABBITMQ_EXCHANGE=votes.exchange
RABBITMQ_ROUTING_KEY=vote.cast

# Max unacked messages per consumer — controls backpressure
RABBITMQ_PREFETCH=100

# PostgreSQL connection string
# Host machine:   postgresql://voteuser:votepass@localhost:5432/votes
# Docker network: postgresql://voteuser:votepass@postgres:5432/votes
DATABASE_URL=postgresql://voteuser:votepass@localhost:5432/votes

# Flush batch when this many votes accumulate
BATCH_SIZE=100

# Flush partial batch after this many milliseconds
BATCH_TIMEOUT_MS=1000

# Identifier stored on each vote row — use something unique per worker instance
WORKER_ID=worker-local

# Redis connection URL
# Host machine:   redis://localhost:6379
# Docker network: redis://redis:6379
REDIS_URL=redis://localhost:6379
