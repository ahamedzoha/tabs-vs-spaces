# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# Docker Compose sets these inline in docker-compose.yml — this file is for
# running the API directly on your host (e.g. pnpm start:dev).

# RabbitMQ connection URL
# Host machine:   amqp://admin:secret@localhost:5672
# Docker network: amqp://admin:secret@rabbitmq:5672
RABBITMQ_URL=amqp://admin:secret@localhost:5672

# HTTP port the NestJS API listens on
PORT=3000

# Deployment zone label — included on each vote message and Prometheus metrics
# Use a unique value per region or instance (e.g. local, us-east-1)
ZONE=local
